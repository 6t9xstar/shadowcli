# AppArmor profile for ShadowCLI on Ubuntu 24.04+ (Noble Numbat)
# Allows unprivileged user namespace creation when kernel.apparmor_restrict_unprivileged_userns=1
# without weakening or disabling system-wide AppArmor security controls.
#
# To install:
#   sudo cp packaging/apparmor/shadow /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/shadow
# Or run:
#   sudo bash scripts/setup_host_apparmor.sh

abi <abi/4.0>,
include <tunables/global>

profile shadow /usr/local/bin/shadow flags=(unconfined) {
  userns,
}

profile shadow-cargo /root/.cargo/bin/shadow flags=(unconfined) {
  userns,
}

profile shadow-user-cargo /home/*/.cargo/bin/shadow flags=(unconfined) {
  userns,
}

profile shadow-target /**/target/**/shadow flags=(unconfined) {
  userns,
}
